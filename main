import React, { useState, useEffect, useCallback, useMemo } from 'react';
import { BookOpen, Plus, Trash2, Volume2, RotateCw, Check, X, Languages } from 'lucide-react';

// Move static data outside component to prevent recreation on every render
const availableLanguages = [
  { code: 'none', name: 'None (English only)', flag: '🇬🇧' },
  { code: 'romanian', name: 'Romanian', flag: '🇷🇴' },
  { code: 'spanish', name: 'Spanish', flag: '🇪🇸' },
  { code: 'french', name: 'French', flag: '🇫🇷' },
  { code: 'italian', name: 'Italian', flag: '🇮🇹' },
  { code: 'portuguese', name: 'Portuguese', flag: '🇵🇹' },
  { code: 'russian', name: 'Russian', flag: '🇷🇺' },
  { code: 'polish', name: 'Polish', flag: '🇵🇱' },
  { code: 'dutch', name: 'Dutch', flag: '🇳🇱' },
  { code: 'turkish', name: 'Turkish', flag: '🇹🇷' },
  { code: 'swedish', name: 'Swedish', flag: '🇸🇪' },
  { code: 'japanese', name: 'Japanese', flag: '🇯🇵' },
  { code: 'chinese', name: 'Chinese', flag: '🇨🇳' },
  { code: 'arabic', name: 'Arabic', flag: '🇸🇦' },
  { code: 'hindi', name: 'Hindi', flag: '🇮🇳' }
];

// API Key configuration - Set this via environment variable or direct assignment
// For production: Use environment variables like REACT_APP_ANTHROPIC_API_KEY
const ANTHROPIC_API_KEY = process.env.REACT_APP_ANTHROPIC_API_KEY || '';

export default function LanguageLearningApp() {
  const [words, setWords] = useState([]);
  const [newWord, setNewWord] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [mode, setMode] = useState('list'); // 'list' or 'learn'
  const [currentCardIndex, setCurrentCardIndex] = useState(0);
  const [showAnswer, setShowAnswer] = useState(false);
  const [stats, setStats] = useState({ correct: 0, total: 0 });
  const [selectedLanguage, setSelectedLanguage] = useState('romanian');

  // Cache speech synthesis voices
  const [cachedVoices, setCachedVoices] = useState([]);

  // Load words from localStorage on mount
  useEffect(() => {
    const savedWords = localStorage.getItem('germanWords');
    if (savedWords) {
      try {
        setWords(JSON.parse(savedWords));
      } catch (error) {
        console.error('Error loading saved words:', error);
      }
    }
  }, []);

  // Save words to localStorage whenever they change
  useEffect(() => {
    if (words.length > 0) {
      localStorage.setItem('germanWords', JSON.stringify(words));
    }
  }, [words]);

  // Load and cache speech synthesis voices
  useEffect(() => {
    const loadVoices = () => {
      const voices = speechSynthesis.getVoices();
      if (voices.length > 0) {
        setCachedVoices(voices);
      }
    };

    // Voices might not be loaded immediately
    loadVoices();

    // Listen for voices changed event (some browsers load voices asynchronously)
    if (speechSynthesis.onvoiceschanged !== undefined) {
      speechSynthesis.onvoiceschanged = loadVoices;
    }

    return () => {
      if (speechSynthesis.onvoiceschanged !== undefined) {
        speechSynthesis.onvoiceschanged = null;
      }
    };
  }, []);

  // Memoize prompt generation function
  const generatePrompt = useCallback((word, languageCode) => {
    const languageName = availableLanguages.find(lang => lang.code === languageCode)?.name || 'Romanian';
    const isEnglishOnly = languageCode === 'none';

    const baseInstructions = 'DO NOT include any text outside the JSON. DO NOT use markdown code blocks. ONLY output the JSON object.';

    if (isEnglishOnly) {
      return `Provide translation and learning information for the German word: "${word}"

Please respond ONLY with a valid JSON object in this exact format (no additional text, no markdown code blocks):
{
  "german": "the German word",
  "english": "English translation",
  "pronunciation": "IPA pronunciation or phonetic guide",
  "partOfSpeech": "noun/verb/adjective/etc",
  "example": "a simple example sentence in German",
  "exampleEnglish": "English translation of the example sentence"
}

${baseInstructions}`;
    }

    return `Provide translation and learning information for the German word: "${word}"

Please respond ONLY with a valid JSON object in this exact format (no additional text, no markdown code blocks):
{
  "german": "the German word",
  "english": "English translation",
  "translation": "${languageName} translation",
  "pronunciation": "IPA pronunciation or phonetic guide",
  "partOfSpeech": "noun/verb/adjective/etc",
  "example": "a simple example sentence in German",
  "exampleEnglish": "English translation of the example sentence",
  "exampleTranslation": "${languageName} translation of the example sentence"
}

${baseInstructions}`;
  }, []);

  const addWord = useCallback(async () => {
    if (!newWord.trim()) return;

    // Check for API key
    if (!ANTHROPIC_API_KEY) {
      alert("API key is not configured. Please set REACT_APP_ANTHROPIC_API_KEY environment variable.");
      return;
    }

    setIsLoading(true);
    try {
      const promptContent = generatePrompt(newWord.trim(), selectedLanguage);

      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": ANTHROPIC_API_KEY,
          "anthropic-version": "2023-06-01"
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          messages: [
            {
              role: "user",
              content: promptContent
            }
          ]
        })
      });

      if (!response.ok) {
        throw new Error(`API request failed with status ${response.status}: ${response.statusText}`);
      }

      const data = await response.json();

      // Better error handling for API response
      if (!data.content || !data.content[0] || !data.content[0].text) {
        throw new Error("Invalid API response format");
      }

      let responseText = data.content[0].text;

      // Clean up the response
      responseText = responseText.replace(/```json\n?/g, "").replace(/```\n?/g, "").trim();

      let wordData;
      try {
        wordData = JSON.parse(responseText);
      } catch (parseError) {
        console.error("JSON parse error:", parseError);
        throw new Error("Failed to parse API response as JSON");
      }

      // Use functional update to avoid stale closure
      setWords(prevWords => [...prevWords, { ...wordData, id: Date.now(), language: selectedLanguage }]);
      setNewWord('');
    } catch (error) {
      console.error("Error adding word:", error);
      alert(`Error adding word: ${error.message}. Please try again.`);
    } finally {
      setIsLoading(false);
    }
  }, [newWord, selectedLanguage, generatePrompt]);

  const deleteWord = useCallback((id) => {
    setWords(prevWords => {
      const updatedWords = prevWords.filter(w => w.id !== id);
      if (updatedWords.length === 0) {
        localStorage.removeItem('germanWords');
      }
      return updatedWords;
    });
  }, []);

  const clearAllWords = useCallback(() => {
    if (window.confirm('Are you sure you want to delete all words? This cannot be undone.')) {
      setWords([]);
      localStorage.removeItem('germanWords');
    }
  }, []);

  const startLearning = useCallback(() => {
    if (words.length === 0) {
      alert("Please add some words first!");
      return;
    }
    setMode('learn');
    setCurrentCardIndex(0);
    setShowAnswer(false);
    setStats({ correct: 0, total: 0 });
  }, [words.length]);

  const nextCard = useCallback(() => {
    setCurrentCardIndex(prevIndex => {
      if (prevIndex < words.length - 1) {
        setShowAnswer(false);
        return prevIndex + 1;
      } else {
        setMode('list');
        alert(`Learning session complete! Score: ${stats.correct}/${stats.total}`);
        return prevIndex;
      }
    });
  }, [words.length, stats.correct, stats.total]);

  const markCorrect = useCallback(() => {
    setStats(prevStats => ({
      correct: prevStats.correct + 1,
      total: prevStats.total + 1
    }));
    nextCard();
  }, [nextCard]);

  const markIncorrect = useCallback(() => {
    setStats(prevStats => ({
      ...prevStats,
      total: prevStats.total + 1
    }));
    nextCard();
  }, [nextCard]);

  // Optimized speak function using cached voices
  const speak = useCallback((text) => {
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'de-DE';
      utterance.rate = 0.85; // Slower = more natural
      utterance.pitch = 1.0;
      utterance.volume = 1.0;

      // Use cached voices instead of fetching every time
      if (cachedVoices.length > 0) {
        const germanVoice = cachedVoices.find(voice =>
          voice.lang.startsWith('de') && (voice.name.includes('Premium') || voice.name.includes('Enhanced'))
        ) || cachedVoices.find(voice => voice.lang.startsWith('de'));

        if (germanVoice) {
          utterance.voice = germanVoice;
        }
      }

      speechSynthesis.speak(utterance);
    } else {
      alert("Text-to-speech is not supported in your browser");
    }
  }, [cachedVoices]);

  // Memoize computed values
  const getLanguageName = useMemo(() => (languageCode) => {
    const lang = availableLanguages.find(l => l.code === languageCode);
    return lang ? lang.name : 'Romanian';
  }, []);

  const getLanguageFlag = useMemo(() => (languageCode) => {
    const lang = availableLanguages.find(l => l.code === languageCode);
    return lang ? lang.flag : '🇷🇴';
  }, []);

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-6">
      <div className="max-w-4xl mx-auto">
        {/* Header */}
        <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <BookOpen className="w-8 h-8 text-indigo-600" />
              <div>
                <h1 className="text-3xl font-bold text-gray-800">German Word Learner</h1>
                <p className="text-gray-600">
                  Learn German with translations in {selectedLanguage === 'none' ? 'English' : `English & ${getLanguageName(selectedLanguage)}`}
                </p>
              </div>
            </div>
            <Languages className="w-12 h-12 text-indigo-400" />
          </div>
        </div>

        {mode === 'list' ? (
          <>
            {/* Input Section */}
            <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
              <h2 className="text-xl font-semibold mb-4 text-gray-800">Add New Word</h2>
              
              {/* Language Selector */}
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Translation Language
                </label>
                <select
                  value={selectedLanguage}
                  onChange={(e) => setSelectedLanguage(e.target.value)}
                  className="w-full md:w-auto px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
                >
                  {availableLanguages.map(lang => (
                    <option key={lang.code} value={lang.code}>
                      {lang.flag} {lang.name}
                    </option>
                  ))}
                </select>
                <p className="text-xs text-gray-500 mt-1">
                  {selectedLanguage === 'none' 
                    ? 'Words will include English translation only' 
                    : 'All words will include English translation plus your selected language'}
                </p>
                <p className="text-xs text-green-600 mt-1">💾 Your words are automatically saved in your browser</p>
              </div>
              
              <div className="flex gap-3">
                <input
                  type="text"
                  value={newWord}
                  onChange={(e) => setNewWord(e.target.value)}
                  onKeyPress={(e) => e.key === 'Enter' && addWord()}
                  placeholder="Enter a German word..."
                  className="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  disabled={isLoading}
                />
                <button
                  onClick={addWord}
                  disabled={isLoading || !newWord.trim()}
                  className="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:bg-gray-400 disabled:cursor-not-allowed flex items-center gap-2 transition-colors"
                >
                  <Plus className="w-5 h-5" />
                  {isLoading ? 'Adding...' : 'Add'}
                </button>
              </div>
            </div>

            {/* Words List */}
            <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-xl font-semibold text-gray-800">Your Words ({words.length})</h2>
                {words.length > 0 && (
                  <div className="flex gap-2">
                    <button
                      onClick={clearAllWords}
                      className="px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 flex items-center gap-2 transition-colors"
                    >
                      <Trash2 className="w-4 h-4" />
                      Clear All
                    </button>
                    <button
                      onClick={startLearning}
                      className="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-2 transition-colors"
                    >
                      <RotateCw className="w-5 h-5" />
                      Start Learning
                    </button>
                  </div>
                )}
              </div>
              
              {words.length === 0 ? (
                <p className="text-gray-500 text-center py-8">No words yet. Add your first word above!</p>
              ) : (
                <div className="space-y-4">
                  {words.map((word) => (
                    <div key={word.id} className="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                      <div className="flex justify-between items-start mb-3">
                        <div className="flex items-center gap-2">
                          <h3 className="text-2xl font-bold text-indigo-600">{word.german}</h3>
                          <button
                            onClick={() => speak(word.german)}
                            className="p-2 hover:bg-gray-100 rounded-full transition-colors"
                            title="Listen to pronunciation"
                          >
                            <Volume2 className="w-5 h-5 text-gray-600" />
                          </button>
                        </div>
                        <button
                          onClick={() => deleteWord(word.id)}
                          className="p-2 hover:bg-red-100 rounded-full transition-colors"
                        >
                          <Trash2 className="w-5 h-5 text-red-500" />
                        </button>
                      </div>
                      
                      <div className="space-y-2">
                        <p className="text-sm text-gray-600">
                          <span className="font-semibold">Type:</span> {word.partOfSpeech}
                        </p>
                        <p className="text-sm text-gray-600">
                          <span className="font-semibold">Pronunciation:</span> {word.pronunciation}
                        </p>
                        
                        <div className={`grid ${word.language === 'none' ? 'grid-cols-1' : 'md:grid-cols-2'} gap-4 mt-3 pt-3 border-t border-gray-200`}>
                          <div>
                            <p className="text-xs text-gray-500 uppercase font-semibold mb-1">🇬🇧 English</p>
                            <p className="text-lg text-gray-800">{word.english}</p>
                          </div>
                          {word.language !== 'none' && word.translation && (
                            <div>
                              <p className="text-xs text-gray-500 uppercase font-semibold mb-1">
                                {getLanguageFlag(word.language)} {getLanguageName(word.language)}
                              </p>
                              <p className="text-lg text-gray-800">{word.translation}</p>
                            </div>
                          )}
                        </div>
                        
                        {word.example && (
                          <div className="mt-3 pt-3 border-t border-gray-200">
                            <p className="text-xs text-gray-500 uppercase font-semibold mb-2">Example</p>
                            <div className="space-y-2">
                              <div className="bg-gray-50 rounded-lg p-3">
                                <p className="text-xs text-gray-500 font-semibold mb-1">🇩🇪 German</p>
                                <p className="text-sm italic text-gray-700">{word.example}</p>
                              </div>
                              
                              {word.exampleEnglish && (
                                <div className="bg-blue-50 rounded-lg p-3">
                                  <p className="text-xs text-gray-500 font-semibold mb-1">🇬🇧 English</p>
                                  <p className="text-sm text-gray-700">{word.exampleEnglish}</p>
                                </div>
                              )}
                              
                              {word.language !== 'none' && word.exampleTranslation && (
                                <div className="bg-indigo-50 rounded-lg p-3">
                                  <p className="text-xs text-gray-500 font-semibold mb-1">
                                    {getLanguageFlag(word.language)} {getLanguageName(word.language)}
                                  </p>
                                  <p className="text-sm text-gray-700">{word.exampleTranslation}</p>
                                </div>
                              )}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </>
        ) : (
          /* Learning Mode - Flashcards */
          <div className="bg-white rounded-lg shadow-lg p-8">
            <div className="mb-6">
              <div className="flex justify-between items-center mb-4">
                <button
                  onClick={() => setMode('list')}
                  className="text-gray-600 hover:text-gray-800 flex items-center gap-2"
                >
                  ← Back to List
                </button>
                <div className="text-right">
                  <p className="text-sm text-gray-600">Progress: {currentCardIndex + 1} / {words.length}</p>
                  <p className="text-sm text-gray-600">Score: {stats.correct} / {stats.total}</p>
                </div>
              </div>
              <div className="w-full bg-gray-200 rounded-full h-2">
                <div 
                  className="bg-indigo-600 h-2 rounded-full transition-all"
                  style={{ width: `${((currentCardIndex + 1) / words.length) * 100}%` }}
                ></div>
              </div>
            </div>

            {words[currentCardIndex] && (
              <div className="text-center">
                <div className="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-12 mb-6 min-h-[300px] flex flex-col justify-center">
                  <div className="flex justify-center items-center gap-3 mb-6">
                    <h2 className="text-5xl font-bold text-indigo-700">
                      {words[currentCardIndex].german}
                    </h2>
                    <button
                      onClick={() => speak(words[currentCardIndex].german)}
                      className="p-3 hover:bg-white rounded-full transition-colors"
                      title="Listen to pronunciation"
                    >
                      <Volume2 className="w-6 h-6 text-indigo-600" />
                    </button>
                  </div>
                  
                  {!showAnswer ? (
                    <button
                      onClick={() => setShowAnswer(true)}
                      className="mx-auto px-8 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors text-lg"
                    >
                      Show Translation
                    </button>
                  ) : (
                    <div className="space-y-4 animate-fadeIn">
                      <p className="text-sm text-gray-600">
                        {words[currentCardIndex].pronunciation}
                      </p>
                      
                      <div className={`grid ${words[currentCardIndex].language === 'none' ? 'grid-cols-1' : 'md:grid-cols-2'} gap-6 mt-6`}>
                        <div className="bg-white rounded-lg p-4 shadow">
                          <p className="text-sm text-gray-500 font-semibold mb-2">🇬🇧 English</p>
                          <p className="text-2xl text-gray-800">{words[currentCardIndex].english}</p>
                        </div>
                        {words[currentCardIndex].language !== 'none' && words[currentCardIndex].translation && (
                          <div className="bg-white rounded-lg p-4 shadow">
                            <p className="text-sm text-gray-500 font-semibold mb-2">
                              {getLanguageFlag(words[currentCardIndex].language)} {getLanguageName(words[currentCardIndex].language)}
                            </p>
                            <p className="text-2xl text-gray-800">{words[currentCardIndex].translation}</p>
                          </div>
                        )}
                      </div>
                      
                      {words[currentCardIndex].example && (
                        <div className="bg-white rounded-lg p-4 shadow mt-4 text-left">
                          <p className="text-sm text-gray-500 font-semibold mb-3">Example</p>
                          <div className="space-y-2">
                            <div className="bg-gray-50 rounded p-2">
                              <p className="text-xs text-gray-500 font-semibold mb-1">🇩🇪 German</p>
                              <p className="text-base italic text-gray-700">{words[currentCardIndex].example}</p>
                            </div>
                            
                            {words[currentCardIndex].exampleEnglish && (
                              <div className="bg-blue-50 rounded p-2">
                                <p className="text-xs text-gray-500 font-semibold mb-1">🇬🇧 English</p>
                                <p className="text-base text-gray-700">{words[currentCardIndex].exampleEnglish}</p>
                              </div>
                            )}
                            
                            {words[currentCardIndex].language !== 'none' && words[currentCardIndex].exampleTranslation && (
                              <div className="bg-indigo-50 rounded p-2">
                                <p className="text-xs text-gray-500 font-semibold mb-1">
                                  {getLanguageFlag(words[currentCardIndex].language)} {getLanguageName(words[currentCardIndex].language)}
                                </p>
                                <p className="text-base text-gray-700">{words[currentCardIndex].exampleTranslation}</p>
                              </div>
                            )}
                          </div>
                        </div>
                      )}
                    </div>
                  )}
                </div>

                {showAnswer && (
                  <div className="flex justify-center gap-4">
                    <button
                      onClick={markIncorrect}
                      className="px-8 py-4 bg-red-500 text-white rounded-lg hover:bg-red-600 flex items-center gap-2 transition-colors text-lg"
                    >
                      <X className="w-6 h-6" />
                      Need Practice
                    </button>
                    <button
                      onClick={markCorrect}
                      className="px-8 py-4 bg-green-500 text-white rounded-lg hover:bg-green-600 flex items-center gap-2 transition-colors text-lg"
                    >
                      <Check className="w-6 h-6" />
                      Got It!
                    </button>
                  </div>
                )}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
